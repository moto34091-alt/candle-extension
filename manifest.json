{
  "manifest_version": 3,
  "name": "MOMO RSI PRO (Pocket Option)",
  "version": "1.2",
  "description": "Momentum + RSI Auto Trader",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://pocketoption.com/*"],
  "content_scripts": [
    {
      "matches": ["https://pocketoption.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
