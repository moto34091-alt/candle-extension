{
  "manifest_version": 3,
  "name": "MOMO RSI MANUAL CLEAN",
  "version": "1.0",
  "description": "Momentum + RSI (Manual Trading)",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://pocketoption.com/*"],
  "content_scripts": [
    {
      "matches": ["https://pocketoption.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
