{
  "manifest_version": 3,
  "name": "MOMO ATR 14 (Manual)",
  "version": "1.0",
  "description": "Momentum + ATR 14 - Manual Trading Tool",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://pocketoption.com/*"],
  "content_scripts": [
    {
      "matches": ["https://pocketoption.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
